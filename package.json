{
  "name": "kashmiri-jewels",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.9",
  "imports": {
    "#/*": "./src/*",
    "#shared/*": "./shared/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "sync:products": "tsx scripts/sync-products.ts",
    "sync:images:r2": "tsx scripts/sync-drive-images-to-r2.ts",
    "sync:images:manifest": "tsx scripts/sync-sheet-images-to-r2.ts",
    "sync:images:r2:upload": "tsx scripts/sync-drive-images-to-r2.ts --upload-manifest",
    "validate:catalog-assets": "tsx scripts/validate-catalog-assets.ts",
    "publish:catalog": "pnpm sync:images:manifest && pnpm sync:products && pnpm validate:catalog-assets && pnpm sync:images:r2:upload && tsx scripts/sync-products-to-supabase.ts",
    "prepare:generated": "tsx scripts/ensure-generated-catalog.ts && tsx scripts/sync-sanity-storefront.ts",
    "generate:favicons": "tsx scripts/generate-favicons.ts",
    "pretypecheck": "pnpm prepare:generated",
    "typecheck": "tsc --noEmit",
    "prebuild:ci": "pnpm prepare:generated",
    "build:ci": "vite build",
    "prebuild": "pnpm prepare:generated",
    "build": "vite build",
    "preview": "vite preview",
    "cf-typegen": "wrangler types",
    "sanity:seed-blog": "tsx scripts/seed-sanity-blog.ts",
    "sync:blog": "tsx scripts/sync-sanity-storefront.ts",
    "sync:content": "tsx scripts/sync-sanity-storefront.ts",
    "studio:dev": "sanity dev",
    "studio:deploy": "sanity deploy"
  },
  "dependencies": {
    "@base-ui/react": "^1.4.1",
    "@orama/orama": "^3.1.18",
    "@portabletext/react": "^6.2.0",
    "@sanity/client": "^7.22.1",
    "@supabase/supabase-js": "^2.105.4",
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-router": "1.169.2",
    "@tanstack/react-start": "1.167.65",
    "googleapis": "^171.4.0",
    "jose": "^6.2.3",
    "lucide-react": "^1.14.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "^4.1.18",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.36.3",
    "@sanity/vision": "4.19.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.1",
    "sanity": "5.31.1",
    "sharp": "0.34.5",
    "styled-components": "6.1.19",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "wrangler": "^4.90.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}
